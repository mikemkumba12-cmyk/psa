# Copy to .env and fill in. Never commit .env.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API cross-origin (not needed in dev: Vite proxies /api).
APP_URL=
# Set to true behind a reverse proxy so client IPs are recorded correctly.
TRUST_PROXY=false

# ── Database (PostgreSQL is required) ───────────────────────────────────────
# Either DATABASE_URL or the PG* variables.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=pinaco
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=disable
# Tests use this database and drop all of its tables on every run.
PGDATABASE_TEST=pinaco_test
# Apply pending migrations automatically when the API starts.
MIGRATE_ON_START=false

# ── Authentication ───────────────────────────────────────────────────────────
# Required in production: a random string of at least 32 characters.
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=12
BCRYPT_ROUNDS=12
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# Passkeys (WebAuthn): the site's domain and the exact origins users visit.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Documents ────────────────────────────────────────────────────────────────
DOCUMENT_STORAGE_DRIVER=local
# Private directory outside any web-served folder. Relative paths resolve from the project root.
DOCUMENT_STORAGE_DIR=.local/documents
DOCUMENT_MAX_BYTES=10485760
# Optional AES-256-GCM encryption at rest: 32 random bytes, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes encrypted documents unreadable. Back it up separately from the files.
DOCUMENT_ENCRYPTION_KEY=

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_DIR=.local/backups
PG_DUMP_PATH=pg_dump

# ── Notifications (optional; without them only in-app notifications are sent) ─
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Pinnacle Financial Services
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ── Assistant (optional self-hosted model; the assistant works without it) ─────
ASSISTANT_OLLAMA_URL=
ASSISTANT_OLLAMA_MODEL=

# ── Background jobs ──────────────────────────────────────────────────────────
BACKGROUND_JOBS=on
ANALYTICS_REFRESH_MINUTES=30

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Leave empty to use same-origin /api (recommended). Dev server proxies to the API.
VITE_API_BASE_URL=
